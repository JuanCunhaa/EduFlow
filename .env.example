# ──────────────────────────────────────────────────
# EduFlow — Environment Variables
# Copy this file to .env.local and fill in your values
# ──────────────────────────────────────────────────

# ── Firebase Client SDK (public — exposed to browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only — NEVER expose to client) ──
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Application Settings ──
# Legacy admin UID — will be replaced by Firebase custom claims
# Set admin roles via: setUserRoles(uid, ['admin'])
ADMIN_UID=

# ── Logging ──
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ── Stripe (Billing / Monetization) ──
# Server-side secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Client-side publishable key (pk_live_... or pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...)
# For local dev: run `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=

# ── Stripe Price IDs ──
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_1T05W7DdL0oPe6wnvK32itSZ
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=price_1T05WEDdL0oPe6wnXkPYA00E
NEXT_PUBLIC_STRIPE_PRICE_TEAM_MONTHLY=price_1T05WHDdL0oPe6wn3tR2bNbn

# ── Billing Feature Flags (defaults: all enabled) ──
# Set to "false" to disable — no deploy required (rollback safety)
PAYWALL_ENABLED=true
CHECKOUT_ENABLED=true
BILLING_WEBHOOK_ENABLED=true

# ── Reconciliation Cron Secret ──
# Protects GET /api/billing/reconcile (nightly Vercel Cron)
CRON_SECRET=
